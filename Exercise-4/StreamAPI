package streamapi;
import java.util.ArrayList;
public class NegativeEven {
    public static void main(String[] args) {
        ArrayList<Integer> numbers = new ArrayList<>();
        numbers.add(10);
        numbers.add(-4);
        numbers.add(7);
        numbers.add(-8);
        numbers.add(-3);
        numbers.add(12);
        numbers.add(-6);
        numbers.add(5);
        ArrayList<Integer> negativeEven = new ArrayList<>();
        for (Integer n : numbers) {
            if (n < 0 && n % 2 == 0) {
                negativeEven.add(n);
            }
        }
        System.out.println("URK23CS1114");
        System.out.println("Negative even numbers:");
        for (Integer n : negativeEven) {
            System.out.println(n);
        }
    }
}